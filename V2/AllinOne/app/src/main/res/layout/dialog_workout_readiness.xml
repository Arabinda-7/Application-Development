<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="READINESS CHECK"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ENERGY LEVEL"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <RadioGroup
            android:id="@+id/rg_energy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_energy_low" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="LOW" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginEnd="4dp"/>
            <RadioButton android:id="@+id/rb_energy_med" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="MED" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginHorizontal="4dp"/>
            <RadioButton android:id="@+id/rb_energy_high" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="HIGH" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginStart="4dp"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MUSCLE SORENESS"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <RadioGroup
            android:id="@+id/rg_soreness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_sore_high" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="HIGH" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginEnd="4dp"/>
            <RadioButton android:id="@+id/rb_sore_mild" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="MILD" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginHorizontal="4dp"/>
            <RadioButton android:id="@+id/rb_sore_none" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="NONE" android:button="@null" android:gravity="center" android:textColor="@color/white" android:background="@drawable/priority_chip_bg" android:layout_marginStart="4dp"/>
        </RadioGroup>

        <TextView
            android:id="@+id/tv_readiness_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#2EC4B6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_calculate_readiness"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_blue_oval_button"
            android:gravity="center"
            android:text="CALCULATE READINESS"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_close_readiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="CLOSE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:padding="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>