<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/finance_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Immersive Background Layer -->
    <View
        android:id="@+id/finance_aura_background"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/finance_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FINANCE"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back" />

        <ImageButton
            android:id="@+id/btn_finance_ledger"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/money_flow"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintEnd_toStartOf="@id/btn_finance_settings"
            app:layout_constraintTop_toTopOf="@id/btn_back" />

        <ImageButton
            android:id="@+id/btn_finance_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_tune_24"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_back" />

        <include
            android:id="@+id/finance_summary"
            layout="@layout/layout_finance_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <RadioGroup
            android:id="@+id/rg_finance_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal"
            android:weightSum="4"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/finance_summary">

            <RadioButton
                android:id="@+id/chip_filter_all"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/filter_chip_bg"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="ALL"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip_filter_expense"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/filter_chip_bg"
                android:button="@null"
                android:gravity="center"
                android:text="EXPENSES"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip_filter_income"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/filter_chip_bg"
                android:button="@null"
                android:gravity="center"
                android:text="INCOME"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip_filter_saving"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/filter_chip_bg"
                android:button="@null"
                android:gravity="center"
                android:text="SAVINGS"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RadioGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/finance_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rg_finance_filters" />

        <!-- Feature 5: Premium Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rg_finance_filters">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/money_flow"
                android:alpha="0.2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your financial journey starts here."
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add your first transaction!"
                android:textColor="#40FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_create_new_finance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#1A73E8"
            app:fabSize="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>