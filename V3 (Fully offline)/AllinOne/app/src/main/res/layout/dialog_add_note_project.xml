<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Sticky Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sticky_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#000000"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_close_note"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/btn_convert_project"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="CONVERT"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/priority_chip_bg"
            android:backgroundTint="#FFB800"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
            app:layout_constraintEnd_toStartOf="@id/btn_save_note"
            app:layout_constraintTop_toTopOf="@id/btn_save_note" />

        <ImageButton
            android:id="@+id/btn_share_idea"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
            app:layout_constraintEnd_toStartOf="@id/btn_mind_map"
            app:layout_constraintTop_toTopOf="@id/btn_save_note" />

        <ImageButton
            android:id="@+id/btn_mind_map"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_habit_tracker"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
            app:layout_constraintEnd_toStartOf="@id/btn_convert_project_icon"
            app:layout_constraintTop_toTopOf="@id/btn_save_note" />

        <ImageButton
            android:id="@+id/btn_convert_project_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_project"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Connect to Project"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
            app:layout_constraintEnd_toStartOf="@id/btn_convert_project"
            app:layout_constraintTop_toTopOf="@id/btn_save_note" />

        <TextView
            android:id="@+id/btn_save_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_close_note"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_close_note" />

        <EditText
            android:id="@+id/note_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@null"
            android:hint="Idea Title"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="32sp"
            android:textStyle="normal"
            android:inputType="textCapSentences"
            app:layout_constraintTop_toBottomOf="@id/btn_close_note" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/sticky_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_char_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 characters"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_priority_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/priority_chip_bg"
                    android:backgroundTint="#2EC4B6"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="LOW"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <EditText
                android:id="@+id/note_content_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="100dp"
                android:background="@null"
                android:hint="Write your idea details here..."
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="#22FFFFFF" />

            <TextView
                android:id="@+id/btn_toggle_journal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IDEA EVOLUTION JOURNAL ▼"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingVertical="8dp" />

            <LinearLayout
                android:id="@+id/container_journal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/journal_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_journal_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Log a new thought..."
                        android:textColor="@color/white"
                        android:textColorHint="#40FFFFFF"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_add_journal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_input_add"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="#22FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDEA SUB-FEATURES"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/container_subfeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/priority_chip_bg"
                android:backgroundTint="#11FFFFFF"
                android:padding="4dp">

                <EditText
                    android:id="@+id/et_new_subfeature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Add a sub-feature..."
                    android:textColor="@color/white"
                    android:textColorHint="#4DFFFFFF"
                    android:textSize="14sp"
                    android:inputType="textCapSentences" />

                <ImageButton
                    android:id="@+id/btn_add_subfeature"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>