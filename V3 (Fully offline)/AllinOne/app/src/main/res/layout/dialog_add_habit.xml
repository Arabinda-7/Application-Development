<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Dynamic Header Area -->
    <View
        android:id="@+id/header_bg_accent"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1A73E8"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_habit"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="SAVE"
            android:textColor="#1A73E8"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_habit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Name Input Section -->
            <EditText
                android:id="@+id/habit_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@null"
                android:hint="New Ritual Name..."
                android:inputType="textCapSentences"
                android:textColor="@color/white"
                android:textColorHint="#40FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_name_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Give your ritual a name to continue"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Direct Day Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SCHEDULE"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_schedule_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select active days for this habit"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/days_container_direct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
                <TextView android:id="@+id/day_0_direct" style="@style/DayButtonCircular" android:text="M" />
                <TextView android:id="@+id/day_1_direct" style="@style/DayButtonCircular" android:text="T" />
                <TextView android:id="@+id/day_2_direct" style="@style/DayButtonCircular" android:text="W" />
                <TextView android:id="@+id/day_3_direct" style="@style/DayButtonCircular" android:text="T" />
                <TextView android:id="@+id/day_4_direct" style="@style/DayButtonCircular" android:text="F" />
                <TextView android:id="@+id/day_5_direct" style="@style/DayButtonCircular" android:text="S" />
                <TextView android:id="@+id/day_6_direct" style="@style/DayButtonCircular" android:text="S" />
            </LinearLayout>

            <!-- Style Options (Icon & Color) - Tightened -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_habit_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/icon_preview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_habit_tracker"
                            app:tint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Choose Icon"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_habit_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <View
                            android:id="@+id/color_preview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_selected_bg"
                            android:backgroundTint="#1A73E8" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Set Theme"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Frequency Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TIME OF DAY"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Morning Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_morning"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌅" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Morning" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Afternoon Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_afternoon"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Afternoon" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Evening Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_evening"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌑" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Evening" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Anytime Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_anytime"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Anytime" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
