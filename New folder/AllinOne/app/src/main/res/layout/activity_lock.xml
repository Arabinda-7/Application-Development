<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lock_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="ENTER PIN"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_lock_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Please enter your security code"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_lock_title" />

    <!-- PIN Visual Indicator (Dots) -->
    <LinearLayout
        android:id="@+id/layout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_lock_sub">

        <View android:id="@+id/dot_1" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/circle_selected_bg" android:backgroundTint="#33FFFFFF" />
        <View android:id="@+id/dot_2" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/circle_selected_bg" android:backgroundTint="#33FFFFFF" />
        <View android:id="@+id/dot_3" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/circle_selected_bg" android:backgroundTint="#33FFFFFF" />
        <View android:id="@+id/dot_4" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="8dp" android:background="@drawable/circle_selected_bg" android:backgroundTint="#33FFFFFF" />

    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/lock_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:columnCount="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1 -->
        <TextView android:id="@+id/btn_1" style="@style/LockKey" android:text="1" />
        <TextView android:id="@+id/btn_2" style="@style/LockKey" android:text="2" />
        <TextView android:id="@+id/btn_3" style="@style/LockKey" android:text="3" />

        <!-- Row 2 -->
        <TextView android:id="@+id/btn_4" style="@style/LockKey" android:text="4" />
        <TextView android:id="@+id/btn_5" style="@style/LockKey" android:text="5" />
        <TextView android:id="@+id/btn_6" style="@style/LockKey" android:text="6" />

        <!-- Row 3 -->
        <TextView android:id="@+id/btn_7" style="@style/LockKey" android:text="7" />
        <TextView android:id="@+id/btn_8" style="@style/LockKey" android:text="8" />
        <TextView android:id="@+id/btn_9" style="@style/LockKey" android:text="9" />

        <!-- Row 4 -->
        <ImageButton android:id="@+id/btn_backspace" style="@style/LockKeyIcon" android:src="@android:drawable/ic_input_delete" />
        <TextView android:id="@+id/btn_0" style="@style/LockKey" android:text="0" />
        <ImageButton android:id="@+id/btn_done" style="@style/LockKeyIcon" android:src="@drawable/icons8_done_100" app:tint="#1A73E8" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>