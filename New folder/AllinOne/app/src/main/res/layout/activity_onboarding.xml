<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_onboarding_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Welcome to All-in-One"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_onboarding_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Let's set up your profile"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_onboarding_welcome" />

    <EditText
        android:id="@+id/et_onboarding_name"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_finance_input"
        android:backgroundTint="#11FFFFFF"
        android:hint="Your Name"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="#40FFFFFF"
        android:textSize="16sp"
        android:inputType="textCapWords"
        app:layout_constraintTop_toBottomOf="@id/tv_onboarding_sub" />

    <TextView
        android:id="@+id/tv_onboarding_avatar_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="CHOOSE YOUR AVATAR"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_onboarding_name" />

    <LinearLayout
        android:id="@+id/container_onboarding_avatars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_onboarding_avatar_label">

        <ImageView
            android:id="@+id/iv_avatar_1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:src="@drawable/boy_avatar_profile"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#33FFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/iv_avatar_2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:src="@drawable/girl_avatar_profile"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#11FFFFFF"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_get_started"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_blue_oval_button"
        android:gravity="center"
        android:text="GET STARTED"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>