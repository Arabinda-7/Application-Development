<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Dynamic Header Area -->
    <View
        android:id="@+id/header_bg_accent_workout"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1A73E8"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_workout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_close_workout"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/btn_save_workout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="SAVE"
            android:textColor="#1A73E8"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_workout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Name Input Section -->
            <EditText
                android:id="@+id/workout_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@null"
                android:hint="Workout Name..."
                android:inputType="textCapSentences"
                android:textColor="@color/white"
                android:textColorHint="#40FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_name_hint_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Give your workout a name to continue"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Direct Day Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SCHEDULE"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_schedule_hint_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select training days"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/days_container_direct_workout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
                <TextView android:id="@+id/day_0_direct_workout" style="@style/DayButtonCircular" android:text="M" />
                <TextView android:id="@+id/day_1_direct_workout" style="@style/DayButtonCircular" android:text="T" />
                <TextView android:id="@+id/day_2_direct_workout" style="@style/DayButtonCircular" android:text="W" />
                <TextView android:id="@+id/day_3_direct_workout" style="@style/DayButtonCircular" android:text="T" />
                <TextView android:id="@+id/day_4_direct_workout" style="@style/DayButtonCircular" android:text="F" />
                <TextView android:id="@+id/day_5_direct_workout" style="@style/DayButtonCircular" android:text="S" />
                <TextView android:id="@+id/day_6_direct_workout" style="@style/DayButtonCircular" android:text="S" />
            </LinearLayout>

            <!-- Style Options (Icon & Color) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_workout_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:id="@+id/icon_preview_workout"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/icons8_exercise_100"
                            app:tint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Choose Icon"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_workout_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <View
                            android:id="@+id/color_preview_workout"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_selected_bg"
                            android:backgroundTint="#1A73E8" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Set Theme"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Tracking Mode Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TRACKING MODE"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mode_reps"
                    style="@style/FrequencyCard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔢" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Reps" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mode_sets"
                    style="@style/FrequencyCard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔁" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sets" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mode_timer"
                    style="@style/FrequencyCard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Timer" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Goal Input -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_target_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Goal Target"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/target_input"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_finance_input"
                            android:backgroundTint="#22FFFFFF"
                            android:gravity="center"
                            android:hint="0"
                            android:inputType="number"
                            android:paddingVertical="8dp"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_target_hint_workout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Set a goal (e.g. 10 reps)"
                        android:textColor="#FF5252"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Muscle Groups -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="MUSCLE GROUPS"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/muscle_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <!-- Time Frequency Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TIME OF DAY"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_morning_workout"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌅" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Morning" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_afternoon_workout"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Afternoon" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_evening_workout"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌑" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Evening" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_anytime_workout"
                    style="@style/FrequencyCard"
                    android:layout_margin="4dp">
                    <LinearLayout style="@style/FrequencyCardContent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Anytime" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
