<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_project_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Immersive Aura Background -->
    <View
        android:id="@+id/aura_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@drawable/bg_project_navy_gradient" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_project_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sticky_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_close_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="@color/white"
                android:contentDescription="Back"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btn_save_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT"
                android:textColor="#1A73E8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_pin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:padding="4dp"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
                app:layout_constraintEnd_toStartOf="@id/btn_save_note"
                app:layout_constraintTop_toTopOf="@id/btn_save_note"
                android:contentDescription="Pin"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btn_delete_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:padding="6dp"
                android:src="@drawable/icons8_trash_100"
                app:tint="#FF5252"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/btn_pin"
                app:layout_constraintEnd_toStartOf="@id/btn_pin"
                app:layout_constraintTop_toTopOf="@id/btn_pin"
                android:contentDescription="Delete Project"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/sticky_header"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="48dp">

                <EditText
                    android:id="@+id/note_title_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@null"
                    android:hint="Project Title"
                    android:textColor="@color/white"
                    android:textColorHint="#40FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Meta Grid (2x2) -->
                <LinearLayout
                    android:id="@+id/layout_project_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/note_title_input">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Status Cell -->
                        <LinearLayout
                            android:id="@+id/cell_status"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/glass_card_bg"
                            android:backgroundTint="@color/glass_white"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_grid_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TODO"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Priority Cell -->
                        <LinearLayout
                            android:id="@+id/cell_priority"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/glass_card_bg"
                            android:backgroundTint="@color/glass_white"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRIORITY"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_grid_priority"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MED"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Theme Cell -->
                        <LinearLayout
                            android:id="@+id/cell_theme"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/glass_card_bg"
                            android:backgroundTint="@color/glass_white"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THEME"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <View
                                android:id="@+id/note_color_preview"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/circle_selected_bg" />
                        </LinearLayout>

                        <!-- Deadline Cell -->
                        <LinearLayout
                            android:id="@+id/cell_deadline"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/glass_card_bg"
                            android:backgroundTint="@color/glass_white"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEADLINE"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_deadline_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Set"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <LinearLayout
                    android:id="@+id/container_description_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/layout_project_meta">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DESCRIPTION"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_description_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="#80FFFFFF" />
                </LinearLayout>

                <EditText
                    android:id="@+id/note_content_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:gravity="top"
                    android:minLines="3"
                    android:enabled="false"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/container_description_header" />

                <!-- Project Goals Section -->
                <LinearLayout
                    android:id="@+id/container_goals_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/note_content_input">

                    <TextView
                        android:id="@+id/btn_toggle_goals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROJECT GOALS ▲"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_goals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/container_goals_header">

                    <!-- Hide input in view mode -->
                    <LinearLayout
                        android:id="@+id/input_goal_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <EditText android:id="@+id/et_goal_input" android:layout_width="0dp" android:layout_height="0dp" />
                        <View android:id="@+id/btn_add_goal" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/goals_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_subfeatures_header_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/container_goals">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SUB-FEATURES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_subfeatures_main_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="#80FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_subfeatures_full_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/layout_subfeatures_header_toggle">

                    <LinearLayout
                        android:id="@+id/container_subfeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <!-- Hide input in view mode -->
                    <LinearLayout
                        android:id="@+id/input_subfeature_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <EditText android:id="@+id/et_new_subfeature" android:layout_width="0dp" android:layout_height="0dp" />
                        <View android:id="@+id/btn_add_subfeature" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_footer_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="64dp"
                        android:gravity="end"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Compatibility placeholders -->
                <RadioGroup android:id="@+id/rg_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <RadioGroup android:id="@+id/rg_priority" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <View android:id="@+id/btn_set_deadline" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>