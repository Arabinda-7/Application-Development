<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_project_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_project_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Sticky Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sticky_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:background="#000000"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_close_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white"
                android:contentDescription="Back"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btn_save_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE"
                android:textColor="#1A73E8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="@id/btn_close_note"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btn_close_note" />

            <ImageView
                android:id="@+id/btn_pin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:padding="4dp"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
                app:layout_constraintEnd_toStartOf="@id/btn_save_note"
                app:layout_constraintTop_toTopOf="@id/btn_save_note"
                android:contentDescription="Pin" />

            <EditText
                android:id="@+id/note_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@null"
                android:hint="Project Title"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:inputType="textCapSentences"
                app:layout_constraintTop_toBottomOf="@id/btn_close_note" />

            <TextView
                android:id="@+id/tv_title_hint_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Define a project title to start"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/note_title_input"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/sticky_header"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="48dp">

                <!-- Templates Section -->
                <LinearLayout
                    android:id="@+id/container_templates_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TEMPLATES"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/scroll_templates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/container_templates_header">
                    <LinearLayout
                        android:id="@+id/container_templates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Meta Section Container -->
                <LinearLayout
                    android:id="@+id/layout_project_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/scroll_templates">

                    <!-- Add Mode: Full Selectors -->
                    <LinearLayout
                        android:id="@+id/layout_add_selectors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STATUS"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="4dp"/>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <RadioGroup
                                android:id="@+id/rg_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <RadioButton
                                    android:id="@+id/rb_status_todo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="TODO"
                                    android:button="@null"
                                    android:paddingHorizontal="16dp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/priority_chip_bg"/>
                                <RadioButton
                                    android:id="@+id/rb_status_progress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="DOING"
                                    android:button="@null"
                                    android:paddingHorizontal="16dp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/priority_chip_bg"/>
                                <RadioButton
                                    android:id="@+id/rb_status_completed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="DONE"
                                    android:button="@null"
                                    android:paddingHorizontal="16dp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/priority_chip_bg"/>
                                <RadioButton
                                    android:id="@+id/rb_status_hold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="HOLD"
                                    android:button="@null"
                                    android:paddingHorizontal="16dp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:textSize="12sp"
                                    android:background="@drawable/priority_chip_bg"/>
                            </RadioGroup>
                        </HorizontalScrollView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIORITY"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"/>

                        <RadioGroup
                            android:id="@+id/rg_priority"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/rb_priority_low"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:text="LOW"
                                android:button="@null"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/priority_chip_bg"/>
                            <RadioButton
                                android:id="@+id/rb_priority_med"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:text="MED"
                                android:button="@null"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/priority_chip_bg"/>
                            <RadioButton
                                android:id="@+id/rb_priority_high"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:text="HIGH"
                                android:button="@null"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:textSize="12sp"
                                android:background="@drawable/priority_chip_bg"/>
                        </RadioGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Color Theme"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <View
                                android:id="@+id/note_color_preview"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/circle_selected_bg" />
                        </LinearLayout>

                        <!-- Deadline Section (Add Mode) -->
                        <LinearLayout
                            android:id="@+id/container_deadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_notes"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_deadline_display"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="No Deadline Set"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/btn_set_deadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SET DEADLINE"
                                android:textColor="#1A73E8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Edit Mode: Compact Selectors Row 1 -->
                    <LinearLayout
                        android:id="@+id/layout_edit_compact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="#0AFFFFFF"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/btn_cycle_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>
                            <TextView
                                android:id="@+id/tv_edit_status_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="IN PROGRESS"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:background="#1AFFFFFF"/>

                        <LinearLayout
                            android:id="@+id/btn_cycle_priority"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRIORITY"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>
                            <TextView
                                android:id="@+id/tv_edit_priority_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="HIGH"
                                android:textColor="#FF5252"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Edit Mode: Compact Meta Row 2 (Color & Deadline) -->
                    <LinearLayout
                        android:id="@+id/layout_edit_compact_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="#0AFFFFFF"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/btn_edit_color"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THEME"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>
                            <View
                                android:id="@+id/tv_edit_color_label"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/circle_selected_bg" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="16dp"
                            android:background="#1AFFFFFF"/>

                        <LinearLayout
                            android:id="@+id/btn_edit_deadline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEADLINE"
                                android:textColor="#80FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>
                            <TextView
                                android:id="@+id/tv_edit_deadline_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="No Deadline"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Progress Slider -->
                <LinearLayout
                    android:id="@+id/container_progress_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/layout_project_meta">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Overall Progress"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tv_progress_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#1A73E8"
                        android:thumbTint="#1A73E8" />
                </LinearLayout>

                <!-- Description Section -->
                <LinearLayout
                    android:id="@+id/container_description_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/container_progress_input">

                    <TextView
                        android:id="@+id/tv_description_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DESCRIPTION"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_description_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="#80FFFFFF" />
                </LinearLayout>

                <EditText
                    android:id="@+id/note_content_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@null"
                    android:hint="Describe the project goal or notes..."
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:gravity="top"
                    android:minLines="3"
                    android:inputType="textMultiLine"
                    app:layout_constraintTop_toBottomOf="@id/container_description_header" />

                <!-- Project Goals Section -->
                <LinearLayout
                    android:id="@+id/container_goals_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/note_content_input">

                    <TextView
                        android:id="@+id/btn_toggle_goals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROJECT GOALS ▲"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_goals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/container_goals_header">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/et_goal_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add a key project goal..."
                            android:textColor="@color/white"
                            android:textColorHint="#4DFFFFFF"
                            android:textSize="14sp"
                            android:background="@null"
                            android:padding="8dp"
                            android:inputType="textCapSentences" />

                        <ImageButton
                            android:id="@+id/btn_add_goal"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_input_add"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/goals_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_subfeatures_header_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/container_goals">

                    <TextView
                        android:id="@+id/tv_subfeatures_header_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SUB-FEATURES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_subfeatures_main_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="#80FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_subfeatures_full_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/layout_subfeatures_header_toggle">

                    <LinearLayout
                        android:id="@+id/container_subfeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/et_new_subfeature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add new sub-feature..."
                            android:textColor="@color/white"
                            android:textColorHint="#4DFFFFFF"
                            android:textSize="14sp"
                            android:background="@null"
                            android:padding="8dp"
                            android:inputType="textCapSentences" />

                        <ImageButton
                            android:id="@+id/btn_add_subfeature"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_input_add"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>