<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Sticky Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_add_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_close_note"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/btn_save_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_close_note"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_close_note" />

        <ImageButton
            android:id="@+id/btn_reminder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_lock_idle_alarm"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@id/btn_save_note"
            app:layout_constraintEnd_toStartOf="@id/btn_save_note"
            app:layout_constraintTop_toTopOf="@id/btn_save_note"
            android:contentDescription="Set Reminder" />

        <ImageButton
            android:id="@+id/btn_voice_input"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@id/btn_reminder"
            app:layout_constraintEnd_toStartOf="@id/btn_reminder"
            app:layout_constraintTop_toTopOf="@id/btn_reminder"
            android:contentDescription="Voice Input" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_add_note"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/note_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:hint="Title"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:textSize="32sp"
                android:textStyle="normal"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/tv_title_hint_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Set a title to save your thoughts"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_note_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21 June 7:42 PM | 0 characters"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/note_color_preview"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/circle_selected_bg" />
            </LinearLayout>

            <EditText
                android:id="@+id/note_content_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@null"
                android:hint="Start typing"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF"
                android:gravity="top"
                android:minLines="10"
                android:inputType="textMultiLine" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
