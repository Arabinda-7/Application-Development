<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/workout_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#1AFFFFFF"
        app:cardBackgroundColor="#1A1A1A">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="12dp">

            <!-- Vertical Accent Bar -->
            <View
                android:id="@+id/accent_bar_workout"
                android:layout_width="4dp"
                android:layout_height="0dp"
                android:background="@color/primary_blue"
                android:alpha="0.8"
                app:layout_constraintTop_toTopOf="@id/icon_container_workout"
                app:layout_constraintBottom_toBottomOf="@id/icon_container_workout"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Icon in Tinted Circle -->
            <FrameLayout
                android:id="@+id/icon_container_workout"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_selected_bg"
                android:backgroundTint="#0DFFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/accent_bar_workout">
                <ImageView
                    android:id="@+id/workout_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_directions"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Text Content -->
            <LinearLayout
                android:id="@+id/text_container_workout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="@id/icon_container_workout"
                app:layout_constraintBottom_toBottomOf="@id/icon_container_workout"
                app:layout_constraintStart_toEndOf="@id/icon_container_workout"
                app:layout_constraintEnd_toStartOf="@id/action_group_workout">

                <TextView
                    android:id="@+id/workout_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/white"
                    android:text="Workout Name" />

                <TextView
                    android:id="@+id/workout_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:letterSpacing="0.02"
                    android:textColor="#80FFFFFF"
                    android:text="0/100 reps" />
            </LinearLayout>

            <!-- Action Group (Chevron + Edit/More) -->
            <LinearLayout
                android:id="@+id/action_group_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_expand_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_menu_more"
                    android:rotation="90"
                    app:tint="#4DFFFFFF" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Expandable Controls Container -->
    <LinearLayout
        android:id="@+id/expandable_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <!-- Controls UI (Reps/Sets or Timer) -->
        <LinearLayout
            android:id="@+id/layout_reps_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_roller_container"
                android:layout_width="80dp"
                android:layout_height="110dp"
                app:cardBackgroundColor="#0F0F0F"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#1AFFFFFF">
                <NumberPicker
                    android:id="@+id/np_workout_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:theme="@style/NumberPickerTheme" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_finish_selection"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#33FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp">
                        <TextView
                            android:id="@+id/tv_selected_num_circle"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/circle_selected_bg"
                            android:backgroundTint="#FBC02D"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#212121"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_finish_reps_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="FINISH 1 REPS"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_finish_all"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#2EC4B6"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/white" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="FINISH ALL"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_start_timer_workout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="gone"
            app:cardBackgroundColor="#252525"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="START TIMER"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>